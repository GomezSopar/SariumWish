@inherits LayoutComponentBase

<div class="app-shell @(_navOpen ? "nav-open" : null)">
    <aside class="app-sidebar">
        <NavMenu OnNavigate="CloseNav" />
    </aside>

    <div class="app-backdrop" @onclick="CloseNav"></div>

    <div class="app-main">
        <header class="app-topbar">
            <button type="button" class="btn btn-sm btn-outline-secondary d-lg-none" aria-label="Toggle navigation" @onclick="ToggleNav">
                <i class="bi bi-list"></i>
            </button>
            <div class="app-topbar-title text-body-secondary small d-none d-sm-block">
                <i class="bi bi-diagram-3 me-1"></i>Project tasks &amp; automated price tracking
            </div>
            <div class="ms-auto d-flex align-items-center gap-2">
                <ThemeToggle />
            </div>
        </header>

        <main class="app-content">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    <i class="bi bi-exclamation-triangle-fill me-2"></i>An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss"><i class="bi bi-x-lg"></i></span>
</div>

@code {
    private bool _navOpen;

    private void ToggleNav() => _navOpen = !_navOpen;

    private void CloseNav() => _navOpen = false;
}
