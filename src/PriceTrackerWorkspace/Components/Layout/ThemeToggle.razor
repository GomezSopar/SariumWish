@inject IJSRuntime JS

<button type="button" class="btn btn-sm btn-outline-secondary" title="Toggle light/dark theme" @onclick="ToggleAsync">
    <i class="bi @(_theme == "dark" ? "bi-sun" : "bi-moon-stars")"></i>
    <span class="d-none d-md-inline ms-1">@(_theme == "dark" ? "Light" : "Dark")</span>
</button>

@code {
    private string _theme = "light";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _theme = await JS.InvokeAsync<string>("workspaceTheme.current");
            StateHasChanged();
        }
    }

    private async Task ToggleAsync() => _theme = await JS.InvokeAsync<string>("workspaceTheme.toggle");
}
