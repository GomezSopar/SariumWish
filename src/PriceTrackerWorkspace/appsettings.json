{
  "ConnectionStrings": {
    "WorkspaceDb": "Server=(localdb)\\mssqllocaldb;Database=PriceTrackerWorkspaceDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Database": {
    "SeedSampleData": true
  },
  "Scraper": {
    "UserAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/156.0.0.0 Safari/537.36",
    "Locale": "en-US",
    "TimezoneId": "America/New_York",
    "ViewportWidth": 1440,
    "ViewportHeight": 900,
    "BrowserChannel": "",
    "Headless": true,
    "AutoInstallBrowser": true,
    "MaxConcurrentPages": 3,
    "NavigationTimeoutMs": 30000,
    "NetworkIdleSettleMs": 4000,
    "SelectorTimeoutMs": 5000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
