<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <PackageReference Include="Microsoft.Playwright" Version="1.64.1" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Scraping\Scripts\*.js" LogicalName="Scripts.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Scraping\Scripts\*.css" LogicalName="Scripts.%(Filename)%(Extension)" />
    <Content Remove="Scraping\Scripts\**" />
    <None Remove="Scraping\Scripts\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PriceTrackerWorkspace.Tests" />
  </ItemGroup>

</Project>
